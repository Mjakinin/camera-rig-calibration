results/bus_real_data/
results/real_vehicle_data/

# Calibration runtime backups and long logs.
results/**/_pipeline_logs/
results/**/*.log

# Detailed row-level parity traces are reproducible generated diagnostics. Keep
# compact parity summaries in Git, not multi-megabyte candidate dumps/diffs.
parity/**/AP01_CANDIDATES.jsonl
parity/**/AP01_CANDIDATE_DIFF.csv

