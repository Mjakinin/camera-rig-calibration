<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <world name="bus_multi_aruco_static_stations">
    <scene>
      <ambient>0.90 0.90 0.90 1</ambient>
      <background>0.70 0.70 0.70 1</background>
      <shadows>false</shadows>
    </scene>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <visualize>false</visualize>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>30 10 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.025 0 0 0</pose>
    </model>

    <include>
      <uri>model://beintelli_bus</uri>
      <name>beintelli_bus</name>
      <pose>-1.8927 25.7211 4.0344 1.5708 0 0</pose>
    </include>

    <include>
      <uri>model://aruco_station_F1_ids_30_35</uri>
      <name>aruco_board_F1_front_mid_far_seat_leaned</name>
      <pose>1.89 -0.75 1.22 0 0.35 0</pose>
    </include>

    <include>
      <uri>model://aruco_station_F2_ids_36_41</uri>
      <name>aruco_board_F2_front_mid_high_left_seat</name>
      <pose>1.97 0.71 1.50 0 0.35 0</pose>
    </include>

    <include>
      <uri>model://aruco_station_F3_ids_00_05</uri>
      <name>aruco_board_F3_front_near_left_seat</name>
      <pose>-3.25 0.71 1.50 0 0.35 0</pose>
    </include>

    <include>
      <uri>model://aruco_station_F4_ids_06_11</uri>
      <name>aruco_board_F4_front_right_table_or_box</name>
      <pose>-2.46 -0.75 1.62 1.57079633 1.57079633 0</pose>
    </include>

    <include>
      <uri>model://aruco_station_R1_ids_24_29</uri>
      <name>aruco_board_R1_rear_left_seat_leaned_occluded</name>
      <pose>3.02 -0.75 1.55 0 0.3 3.14159265</pose>
    </include>

    <include>
      <uri>model://aruco_station_R2_ids_18_23</uri>
      <name>aruco_board_R2_rear_table_flat</name>
      <pose>4.83 -0.09 1.52 1.57079633 1.57079633 3.14159265</pose>
    </include>

    <include>
      <uri>model://aruco_station_R3_ids_12_17</uri>
      <name>aruco_board_R3_rear_right_seat_angled</name>
      <pose>4.27 0.93 1.55 0 0.3 1.57079633</pose>
    </include>

    <include>
      <uri>model://aruco_station_G_ids_42_47</uri>
      <name>aruco_board_G_floor_mid</name>
      <pose>1.50 0.0 0.39 1.57079633 1.57079633 3.14159265</pose>
    </include>


    <model name="front_static_camera">
      <static>true</static>
      <pose>-3.90 0.0 2.85 0 0.69813170 0</pose>
      <link name="link">
        <sensor name="front_static_camera" type="camera">
          <visualize>false</visualize>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/front_static_camera/image</topic>
          <camera>
            <horizontal_fov>1.57079633</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>30</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="rear_static_camera">
      <static>true</static>
      <pose>5.70 0.0 2.85 0 0.69813170 3.14159265</pose>
      <link name="link">
        <sensor name="rear_static_camera" type="camera">
          <visualize>false</visualize>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/rear_static_camera/image</topic>
          <camera>
            <horizontal_fov>1.57079633</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>30</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="moving_calib_camera">
      <static>true</static>
      <pose>4.20 0.0 1.75 0 0 3.14159265</pose>
      <link name="link">
        <sensor name="moving_calib_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <topic>/moving_calib_camera/image</topic>
          <camera>
            <horizontal_fov>1.57079633</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
