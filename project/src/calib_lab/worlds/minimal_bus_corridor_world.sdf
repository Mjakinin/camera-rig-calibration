<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="minimal_bus_corridor_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.78 0.82 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="ceiling_light" type="directional">
      <pose>0 0 5.0 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.4 0 -0.9</direction>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Minimal bus corridor: x = bus length, y = bus width, z = height -->

    <model name="corridor_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.0 1.4 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 1.4 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="left_wall">
      <static>true</static>
      <pose>0 0.7 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.0 0.05 2.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 0.05 2.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.78 1</ambient>
            <diffuse>0.80 0.80 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_wall">
      <static>true</static>
      <pose>0 -0.7 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.0 0.05 2.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 0.05 2.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.78 1</ambient>
            <diffuse>0.80 0.80 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="ceiling">
      <static>true</static>
      <pose>0 0 2.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 1.4 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.70 0.70 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Front static camera: looking along +X -->
    <model name="front_static_camera">
      <static>true</static>
      <pose>-3.8 0 1.4 0 0 0</pose>
      <link name="camera_link">
        <visual name="body">
          <geometry>
            <box>
              <size>0.20 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>

        <sensor name="front_camera_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>/front_static_camera/image</topic>
          <camera_info_topic>/front_static_camera/camera_info</camera_info_topic>

          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Rear static camera: looking along -X -->
    <model name="rear_static_camera">
      <static>true</static>
      <pose>3.8 0 1.4 0 0 3.14159</pose>
      <link name="camera_link">
        <visual name="body">
          <geometry>
            <box>
              <size>0.20 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>

        <sensor name="rear_camera_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>/rear_static_camera/image</topic>
          <camera_info_topic>/rear_static_camera/camera_info</camera_info_topic>

          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Moving camera: will be moved by external script -->
    <model name="moving_camera">
      <static>false</static>
      <pose>-3.2 0 1.3 0 0 0</pose>

      <link name="camera_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <visual name="body">
          <geometry>
            <box>
              <size>0.20 0.10 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 0.10 0.10</size>
            </box>
          </geometry>
        </collision>

        <sensor name="moving_camera_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>/moving_camera/image</topic>
          <camera_info_topic>/moving_camera/camera_info</camera_info_topic>

          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
