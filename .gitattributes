# Normalize text files.
* text=auto

# Ordinary binary files are stored directly in regular Git.
*.png -text
*.jpg -text
*.jpeg -text
*.obj -text
*.dae -text
*.stl -text
*.fbx -text
*.glb -text
*.gltf -text
*.mesh -text
*.bin -text
*.db -text
*.sqlite -text
*.ply -text
*.bag -text
*.mcap -text
*.zip -text
*.7z -text
*.gz -text

# The large bus OBJ is stored as an ordinary-Git gzip archive and materialized
# locally by rigcal. This repository intentionally has no Git LFS rules.
