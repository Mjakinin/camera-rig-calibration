def main():
    m = load_chain_module()

    entries = []

    direct_multi = load_multimarker_direct_if_available(m)
    if direct_multi is not None:
        entries.append(direct_multi)
        direct_source = "robust multi-marker weighted mean of MAD inliers"
    else:
        entries.append(compute_direct_single_marker_fallback(m, marker_id=1))
        direct_source = "single marker 1 fallback because multi-marker result was not found"

    # Final no-GT COLMAP relay estimates.
    entries.append(compute_relay_from_row(m, best_relay_row("cam3_to_cam0", "COLMAP_motion")))
    entries.append(compute_relay_from_row(m, best_relay_row("cam3_to_cam5", "COLMAP_motion")))

    # Oracle/sanity relay variants. Keep them in the report, clearly marked.
    entries.append(compute_relay_from_row(m, best_relay_row("cam3_to_cam0", "GT_motion")))
    entries.append(compute_relay_from_row(m, best_relay_row("cam3_to_cam5", "GT_motion")))

    ref14_rows, ref14_meta = build_ref14_eval_rows(m, entries)

    write_cam3_summary(entries)
    write_ref14_eval(ref14_rows)
    write_json(entries, ref14_rows, ref14_meta)
    write_readme(entries, ref14_rows, direct_source)


if __name__ == "__main__":
    main()
