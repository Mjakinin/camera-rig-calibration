def build_ref14_eval_rows(m, entries):
    T_W_ref14, ref14_pose_vals = parse_ref14_world_pose()
    T_ref14_W = invT(T_W_ref14)

    T_W_cam3 = m.T_W_optical_from_sdf_model(ROOT_CAM)
    T_ref14_cam3_gt = T_ref14_W @ T_W_cam3

    rows = []

    # Root camera itself: this is GT/eval anchor, not an estimated deployable measurement.
    rows.append({
        "camera": ROOT_CAM,
        "source_entry": "root_camera_eval_anchor",
        "method": "gt_eval_ref14_to_cam3_anchor",
        "is_root_camera": True,
        "T_ref14_cam_est": T_ref14_cam3_gt,
        "T_ref14_cam_gt": T_ref14_cam3_gt,
        "translation_error_m": 0.0,
        "rotation_error_deg": 0.0,
        "notes": (
            "EVAL_ONLY: cam_edge_3 pose in marker14 frame is computed from GT world/SDF. "
            "This is used only to express final cam3-root estimates in the marker14 GT evaluation frame."
        ),
    })

    for e in entries:
        target_cam = e["target_camera"]

        T_cam3_target_est = e["T_est"]
        T_ref14_target_est = T_ref14_cam3_gt @ T_cam3_target_est

        T_W_target = m.T_W_optical_from_sdf_model(target_cam)
        T_ref14_target_gt = T_ref14_W @ T_W_target

        rows.append({
            "camera": target_cam,
            "source_entry": e["name"],
            "method": e["method"],
            "is_root_camera": False,
            "T_ref14_cam_est": T_ref14_target_est,
            "T_ref14_cam_gt": T_ref14_target_gt,
            "translation_error_m": trans_error(T_ref14_target_est, T_ref14_target_gt),
            "rotation_error_deg": rot_error_deg(T_ref14_target_est, T_ref14_target_gt),
            "notes": (
                "EVAL_ONLY marker14 frame. The calibration itself was estimated in cam_edge_3 frame; "
                "the transform into marker14 frame uses GT T_marker14_cam3 for simulation reporting."
            ),
        })

    meta = {
        "reference_marker_entity": REF14_ENTITY,
        "reference_marker_pose_world_sdf": {
            "x": ref14_pose_vals[0],
            "y": ref14_pose_vals[1],
            "z": ref14_pose_vals[2],
            "roll": ref14_pose_vals[3],
            "pitch": ref14_pose_vals[4],
            "yaw": ref14_pose_vals[5],
        },
        "important_note": (
            "This marker14 frame export is evaluation-only. "
            "It uses the GT/SDF pose of marker14 and cam_edge_3 to transform final cam3-root estimates into a physical reference coordinate frame."
        ),
        "T_ref14_cam3_gt": pose_payload(T_ref14_cam3_gt),
    }

    return rows, meta


