#!/usr/bin/env python3

from __future__ import annotations

import json
import xml.etree.ElementTree as ET
from pathlib import Path
from typing import Sequence


BASE_WORLD = Path(
    "src/calib_lab/bus_real_data/worlds/"
    "bus_real_data_moving_camera.sdf"
)

OUTPUT_DIR = Path(
    "src/calib_lab/bus_real_data/worlds/lighting"
)


# ---------------------------------------------------------------------------
# Fixed experiment geometry
# ---------------------------------------------------------------------------

PANEL_X = 0.60
PANEL_Y_VALUES = (-0.45, 0.45)
PANEL_Z = 2.70

PANEL_LENGTH = 10.40
PANEL_WIDTH = 0.14
PANEL_THICKNESS = 0.025

# Seven emitters per strip. Their spacing is close enough that the radial
# fields merge smoothly, but each source remains weak.
LIGHT_X_VALUES = (
    -4.20,
    -2.60,
    -1.00,
    0.60,
    2.20,
    3.80,
    5.40,
)

LIGHT_Z = 2.61

# Exact x midpoint of markers 3 and 4, shifted inward from the wall.
DOOR_LIGHT_X = 0.40
DOOR_LIGHT_Y = 0.80
DOOR_LIGHT_Z = 2.58

DOOR_PANEL_Z = 2.70
DOOR_PANEL_LENGTH = 0.72
DOOR_PANEL_WIDTH = 0.34
DOOR_PANEL_THICKNESS = 0.025


# Same attenuation for every brightness stage.
COMMON_ATTENUATION = {
    "range_m": 4.60,
    "constant": 0.88,
    "linear": 0.095,
    "quadratic": 0.022,
}


# Positions and attenuation remain unchanged.
# Only intensity, ambient approximation and visible panel emission change.
VARIANTS = {
    "ceiling_low": {
        "ambient": (0.030, 0.031, 0.038, 1.0),
        "light_diffuse": (0.035, 0.036, 0.040, 1.0),
        "light_specular": (0.003, 0.003, 0.004, 1.0),
        "panel_emissive": (0.045, 0.046, 0.050, 1.0),
    },
    "ceiling_baseline": {
        "ambient": (0.160, 0.160, 0.170, 1.0),
        "light_diffuse": (0.170, 0.165, 0.150, 1.0),
        "light_specular": (0.018, 0.018, 0.016, 1.0),
        "panel_emissive": (0.320, 0.310, 0.280, 1.0),
    },
    "ceiling_bright": {
        "ambient": (0.235, 0.235, 0.245, 1.0),
        "light_diffuse": (0.290, 0.275, 0.240, 1.0),
        "light_specular": (0.040, 0.038, 0.033, 1.0),
        "panel_emissive": (0.650, 0.620, 0.540, 1.0),
    },
    "ceiling_extreme": {
        "ambient": (0.315, 0.315, 0.325, 1.0),
        "light_diffuse": (0.460, 0.430, 0.360, 1.0),
        "light_specular": (0.075, 0.070, 0.058, 1.0),
        "panel_emissive": (1.000, 0.950, 0.820, 1.0),
    },
}


def find_world(root: ET.Element) -> ET.Element:
    world = root.find("world")

    if world is None:
        world = next(root.iter("world"), None)

    if world is None:
        raise RuntimeError("No <world> element found")

    return world


def set_child(
    parent: ET.Element,
    tag: str,
    text: str,
) -> ET.Element:
    node = parent.find(tag)

    if node is None:
        node = ET.SubElement(parent, tag)

    node.text = text
    return node


def rgba(values: Sequence[float]) -> str:
    if len(values) != 4:
        raise ValueError(f"Expected four RGBA components: {values}")

    for value in values:
        if not 0.0 <= float(value) <= 1.0:
            raise ValueError(
                f"RGBA component outside [0,1]: {value}"
            )

    return " ".join(
        f"{float(value):.6f}"
        for value in values
    )


def scale_rgba(
    values: Sequence[float],
    factor: float,
) -> tuple[float, float, float, float]:
    return (
        min(1.0, max(0.0, float(values[0]) * factor)),
        min(1.0, max(0.0, float(values[1]) * factor)),
        min(1.0, max(0.0, float(values[2]) * factor)),
        float(values[3]),
    )


def remove_generated_content(world: ET.Element) -> None:
    for light in list(world.findall("light")):
        world.remove(light)

    for model in list(world.findall("model")):
        if model.get("name") == "bus_ceiling_led_panels":
            world.remove(model)


def configure_scene(
    world: ET.Element,
    ambient: Sequence[float],
) -> None:
    scene = world.find("scene")

    if scene is None:
        scene = ET.SubElement(world, "scene")

    set_child(scene, "ambient", rgba(ambient))

    # Constant background avoids introducing another ablation variable.
    set_child(
        scene,
        "background",
        rgba((0.48, 0.52, 0.60, 1.0)),
    )

    set_child(scene, "shadows", "true")


def add_box_visual(
    link: ET.Element,
    *,
    name: str,
    pose: str,
    size: str,
    emissive: Sequence[float],
) -> None:
    visual = ET.SubElement(
        link,
        "visual",
        {"name": name},
    )

    set_child(visual, "pose", pose)

    geometry = ET.SubElement(visual, "geometry")
    box = ET.SubElement(geometry, "box")
    set_child(box, "size", size)

    material = ET.SubElement(visual, "material")

    set_child(material, "ambient", rgba(emissive))
    set_child(material, "diffuse", rgba(emissive))
    set_child(
        material,
        "specular",
        rgba((0.10, 0.10, 0.09, 1.0)),
    )
    set_child(material, "emissive", rgba(emissive))


def add_panel_model(
    world: ET.Element,
    emissive: Sequence[float],
) -> None:
    model = ET.SubElement(
        world,
        "model",
        {"name": "bus_ceiling_led_panels"},
    )

    set_child(model, "static", "true")

    link = ET.SubElement(
        model,
        "link",
        {"name": "ceiling_led_panel_link"},
    )

    for index, y in enumerate(PANEL_Y_VALUES):
        add_box_visual(
            link,
            name=f"ceiling_led_strip_{index}",
            pose=(
                f"{PANEL_X:.6f} "
                f"{y:.6f} "
                f"{PANEL_Z:.6f} "
                "0 0 0"
            ),
            size=(
                f"{PANEL_LENGTH:.6f} "
                f"{PANEL_WIDTH:.6f} "
                f"{PANEL_THICKNESS:.6f}"
            ),
            emissive=emissive,
        )

    add_box_visual(
        link,
        name="door_ceiling_led_panel",
        pose=(
            f"{DOOR_LIGHT_X:.6f} "
            f"{DOOR_LIGHT_Y:.6f} "
            f"{DOOR_PANEL_Z:.6f} "
            "0 0 0"
        ),
        size=(
            f"{DOOR_PANEL_LENGTH:.6f} "
            f"{DOOR_PANEL_WIDTH:.6f} "
            f"{DOOR_PANEL_THICKNESS:.6f}"
        ),
        emissive=scale_rgba(emissive, 0.90),
    )


def add_point_light(
    world: ET.Element,
    *,
    name: str,
    x: float,
    y: float,
    z: float,
    diffuse: Sequence[float],
    specular: Sequence[float],
    range_m: float,
    constant: float,
    linear: float,
    quadratic: float,
) -> None:
    light = ET.SubElement(
        world,
        "light",
        {
            "name": name,
            "type": "point",
        },
    )

    set_child(
        light,
        "pose",
        f"{x:.6f} {y:.6f} {z:.6f} 0 0 0",
    )

    # Multiple ceiling emitters should not generate many hard shadows.
    set_child(light, "cast_shadows", "false")
    set_child(light, "diffuse", rgba(diffuse))
    set_child(light, "specular", rgba(specular))

    attenuation = ET.SubElement(light, "attenuation")

    set_child(attenuation, "range", f"{range_m:.6f}")
    set_child(attenuation, "constant", f"{constant:.6f}")
    set_child(attenuation, "linear", f"{linear:.6f}")
    set_child(attenuation, "quadratic", f"{quadratic:.6f}")


def add_strip_point_lights(
    world: ET.Element,
    *,
    diffuse: Sequence[float],
    specular: Sequence[float],
) -> None:
    index = 0

    for y in PANEL_Y_VALUES:
        for x in LIGHT_X_VALUES:
            add_point_light(
                world,
                name=f"ceiling_strip_point_{index:02d}",
                x=x,
                y=y,
                z=LIGHT_Z,
                diffuse=diffuse,
                specular=specular,
                range_m=COMMON_ATTENUATION["range_m"],
                constant=COMMON_ATTENUATION["constant"],
                linear=COMMON_ATTENUATION["linear"],
                quadratic=COMMON_ATTENUATION["quadratic"],
            )

            index += 1


def add_door_light(
    world: ET.Element,
    *,
    diffuse: Sequence[float],
    specular: Sequence[float],
) -> None:
    add_point_light(
        world,
        name="door_ceiling_point",
        x=DOOR_LIGHT_X,
        y=DOOR_LIGHT_Y,
        z=DOOR_LIGHT_Z,
        diffuse=scale_rgba(diffuse, 0.72),
        specular=scale_rgba(specular, 0.55),
        range_m=3.20,
        constant=0.78,
        linear=0.105,
        quadratic=0.027,
    )


def validate_world(
    root: ET.Element,
    variant: str,
) -> None:
    world = find_world(root)

    lights = world.findall("light")

    # 14 strip emitters plus one local door emitter.
    if len(lights) != 15:
        raise RuntimeError(
            f"{variant}: expected 15 lights, found {len(lights)}"
        )

    for light in lights:
        if light.get("type") != "point":
            raise RuntimeError(
                f"{variant}: found non-point light "
                f"{light.get('name')}"
            )

        if light.findtext("cast_shadows") != "false":
            raise RuntimeError(
                f"{variant}: point light unexpectedly casts shadows"
            )

        if light.find("spot") is not None:
            raise RuntimeError(
                f"{variant}: obsolete spotlight configuration remains"
            )

    panel_models = [
        model
        for model in world.findall("model")
        if model.get("name") == "bus_ceiling_led_panels"
    ]

    if len(panel_models) != 1:
        raise RuntimeError(
            f"{variant}: expected one LED panel model"
        )

    visuals = list(panel_models[0].iter("visual"))

    if len(visuals) != 3:
        raise RuntimeError(
            f"{variant}: expected two strips and one door panel"
        )

    color_tags = {
        "ambient",
        "background",
        "diffuse",
        "specular",
        "emissive",
    }

    for node in root.iter():
        if node.tag not in color_tags or not node.text:
            continue

        values = [
            float(value)
            for value in node.text.split()
        ]

        if len(values) != 4:
            raise RuntimeError(
                f"{variant}: malformed <{node.tag}> value"
            )

        for value in values:
            if not 0.0 <= value <= 1.0:
                raise RuntimeError(
                    f"{variant}: <{node.tag}> outside [0,1]: "
                    f"{value}"
                )


def write_variant(
    variant: str,
    config: dict,
) -> None:
    tree = ET.parse(BASE_WORLD)
    root = tree.getroot()
    world = find_world(root)

    remove_generated_content(world)

    configure_scene(
        world,
        config["ambient"],
    )

    add_panel_model(
        world,
        config["panel_emissive"],
    )

    add_strip_point_lights(
        world,
        diffuse=config["light_diffuse"],
        specular=config["light_specular"],
    )

    add_door_light(
        world,
        diffuse=config["light_diffuse"],
        specular=config["light_specular"],
    )

    validate_world(root, variant)

    ET.indent(tree, space="  ")

    output = OUTPUT_DIR / (
        f"bus_real_data_moving_camera_light_{variant}.sdf"
    )

    tree.write(
        output,
        encoding="utf-8",
        xml_declaration=True,
    )

    ET.parse(output)

    print(
        f"[OK] {variant:20s} -> {output} "
        "(2 strips, 14 point emitters, 1 door emitter)"
    )


def main() -> None:
    if not BASE_WORLD.exists():
        raise SystemExit(
            f"[ERROR] Missing base world: {BASE_WORLD}"
        )

    OUTPUT_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    for old_file in OUTPUT_DIR.glob(
        "bus_real_data_moving_camera_light_*.sdf"
    ):
        old_file.unlink()

    for variant, config in VARIANTS.items():
        write_variant(
            variant,
            config,
        )

    metadata = {
        "experiment": "diffuse_ceiling_light_intensity_ablation",
        "panel_count": 2,
        "point_emitters_per_panel": len(LIGHT_X_VALUES),
        "strip_point_emitter_count": (
            len(PANEL_Y_VALUES) * len(LIGHT_X_VALUES)
        ),
        "door_point_emitter_count": 1,
        "light_types": ["point"],
        "panel_y_m": list(PANEL_Y_VALUES),
        "light_x_m": list(LIGHT_X_VALUES),
        "door_light_xyz_m": [
            DOOR_LIGHT_X,
            DOOR_LIGHT_Y,
            DOOR_LIGHT_Z,
        ],
        "attenuation": COMMON_ATTENUATION,
        "variants": VARIANTS,
        "notes": [
            "No spotlight cones are used.",
            "Point emitters approximate broad diffused LED panels.",
            "Ambient approximates indirect interreflection.",
            "Geometry and attenuation are identical across stages.",
        ],
    }

    metadata_path = OUTPUT_DIR / "LIGHTING_VARIANTS.json"

    metadata_path.write_text(
        json.dumps(metadata, indent=2) + "\n"
    )

    readme = OUTPUT_DIR / "LIGHTING_VARIANTS.txt"

    readme.write_text(
        "Diffuse bus ceiling-light ablation\n"
        "==================================\n\n"
        "Visuals:\n"
        "  Two continuous ceiling LED strips.\n"
        "  One local door-area LED panel.\n\n"
        "Physical approximation:\n"
        "  Seven weak point emitters per strip.\n"
        "  Fourteen strip emitters total.\n"
        "  One local door point emitter.\n"
        "  No spot lights and no cone falloff boundaries.\n"
        "  Ambient approximates indirect light bounce.\n\n"
        "Stages:\n"
        "  ceiling_low\n"
        "  ceiling_baseline\n"
        "  ceiling_bright\n"
        "  ceiling_extreme\n"
    )

    print(f"[OK] wrote {metadata_path}")
    print(f"[OK] wrote {readme}")


if __name__ == "__main__":
    main()
